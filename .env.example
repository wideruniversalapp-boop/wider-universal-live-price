# Firebase web app config (Project settings > General > Your apps). These values are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Set to "true" to connect the app to the local emulators instead of a real project.
VITE_USE_EMULATORS=false
